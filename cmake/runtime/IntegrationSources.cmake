# Original portable profile closure; no SDL, settings, FFmpeg or game corpus.
set(YAKUMO_PROFILE_PORTABLE_SOURCES)
foreach(source audio/guest_pcm audio/sas_core input/bindings input/chords input/presets)
    list(APPEND YAKUMO_PROFILE_PORTABLE_SOURCES "${YAKUMO_ROOT}/upstream/Yakumo/profiles/mhp3rd/host/${source}.cpp")
endforeach()
set(YAKUMO_INTEGRATION_FIXTURES "${YAKUMO_ROOT}/out/integration-fixtures")
set(YAKUMO_INTEGRATION_MODULE_COUNT 32 CACHE STRING "Synthetic module measurement size: 2, 8 or 32")
if(NOT YAKUMO_INTEGRATION_MODULE_COUNT MATCHES "^(2|8|32)$")
    message(FATAL_ERROR "Synthetic module count must be 2, 8 or 32")
endif()
math(EXPR integration_last "${YAKUMO_INTEGRATION_MODULE_COUNT}-1")
set(YAKUMO_INTEGRATION_GENERATED_SOURCES)
foreach(index RANGE ${integration_last})
    if(index LESS 10)
        set(number "0${index}")
    else()
        set(number "${index}")
    endif()
    set(directory "${YAKUMO_INTEGRATION_FIXTURES}/integration_${number}")
    file(GLOB units CONFIGURE_DEPENDS "${directory}/generated/*.cpp")
    list(APPEND YAKUMO_INTEGRATION_GENERATED_SOURCES "${directory}/module.cpp" ${units})
endforeach()
