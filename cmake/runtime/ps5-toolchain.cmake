set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
get_filename_component(_yakumo_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(MHP3RD_SDK_ROOT "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "SDK built locally from the pinned source")
if(NOT EXISTS "${MHP3RD_SDK_ROOT}/bin/prospero-lld")
    message(FATAL_ERROR "Build the pinned SDK source first")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MHP3RD_SDK_ROOT)
set(ENV{PS5_PAYLOAD_SDK} "${MHP3RD_SDK_ROOT}")
set(ENV{PS5_CLANG} "clang-18")
set(CMAKE_CXX_COMPILER "${_yakumo_root}/deps/PS5_Vulkan/tooling/prospero-clang18")
set(CMAKE_CXX_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;PS5_PAYLOAD_SDK=${MHP3RD_SDK_ROOT};PS5_CLANG=clang-18")
set(CMAKE_AR llvm-ar-18)
set(CMAKE_RANLIB llvm-ranlib-18)
