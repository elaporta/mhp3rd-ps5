FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential cmake ninja-build git python3 python3-yaml python3-ply \
    python3-packaging python3-pyelftools pkg-config clang-18 lld-18 llvm-18-dev libclang-18-dev \
    libclang-cpp18-dev libclc-18 libclc-18-dev libllvmspirvlib-18-dev \
    glslang-tools spirv-tools bison flex rsync xz-utils zlib1g-dev libvulkan-dev \
    libelf-dev libexpat1-dev libzstd-dev && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
